{
  "policy_version": "1",
  "owner": "calebhaines",
  "visibility": "public",
  "authorized_collaborators": ["calebhaines"],
  "pull_request_creation_policy": "collaborators_only",
  "protected_branch": "main",
  "branch_protection": {
    "required_status_checks": {
      "strict": true,
      "checks": [
        {"context": "validate (3.11)", "app_id": 15368},
        {"context": "validate (3.12)", "app_id": 15368},
        {"context": "validate (3.13)", "app_id": 15368},
        {"context": "base-install", "app_id": 15368}
      ]
    },
    "enforce_admins": true,
    "required_pull_request_reviews": {
      "required_approving_review_count": 0,
      "dismiss_stale_reviews": true,
      "require_code_owner_reviews": false,
      "require_last_push_approval": false
    },
    "restrictions": null,
    "required_linear_history": true,
    "required_conversation_resolution": true,
    "allow_force_pushes": false,
    "allow_deletions": false
  },
  "workflow_permissions": {
    "default_workflow_permissions": "read",
    "can_approve_pull_request_reviews": false
  },
  "fork_workflow_approval": "all_external_contributors"
}
